# Public SPA configuration. Never put a client secret here: the SPA is a public
# OAuth client with token_endpoint_auth_method=none.
VITE_SPA_CLIENT_ID=pfa-web-dev
VITE_SPA_CALLBACK_URI=http://127.0.0.1:5173/auth/callback
# Web services origin. Every request from the SPA goes here directly; there is no
# dev-server proxy, so the browser performs the real CORS preflight.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_AUTHORIZATION_ORIGIN=http://127.0.0.1:8000
