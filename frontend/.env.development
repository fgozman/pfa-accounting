# Public SPA configuration for local development. No secrets: the SPA is an
# OAuth public client (token_endpoint_auth_method=none).
#
# The authorization service is a DIFFERENT origin from the SPA. If
# VITE_AUTHORIZATION_ORIGIN is missing, the SPA falls back to its own origin and
# the login button navigates to itself instead of the login page.
# Web services origin. Every request from the SPA goes here directly; there is no
# dev-server proxy, so the browser performs the real CORS preflight.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_AUTHORIZATION_ORIGIN=http://127.0.0.1:8000
VITE_SPA_CLIENT_ID=pfa-web-dev
VITE_SPA_CALLBACK_URI=http://127.0.0.1:5173/auth/callback
