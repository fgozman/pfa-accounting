# Repository-wide ignores for the two projects (backend/, frontend/).

# --- Environment -----------------------------------------------------------
.env
.env.*
!.env.example
# The SPA's committed local defaults contain no secrets (public OAuth client,
# localhost only), so `.env.development` is tracked on purpose.
!frontend/.env.development

# --- Python (backend/) -----------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
# Generated OpenAPI artifact; the frontend pins its own copy.
backend/openapi.json

# --- Node (frontend/) ------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo

# --- Local state / secrets -------------------------------------------------
keys/
.run/
*.log
.DS_Store
