        "type": "loki",
        "uid": "pfa-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "pfa-loki"
          },
          "expr": "sum(count_over_time({service_name=~\"$service\", env=~\"$env\", event=\"audit\"} | json | pfa_audit_action=\"account.login_failed\" [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
