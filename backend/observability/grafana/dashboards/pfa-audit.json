    {
      "type": "logs",
      "title": "Audit trail",
      "description": "Every committed audit_events row, as logged. Expand a line for all fields and the link to its trace.",
      "datasource": {
        "type": "loki",
        "uid": "pfa-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "pfa-loki"
          },
          "expr": "{service_name=~\"$service\", env=~\"$env\", event=\"audit\"} | json | line_format \"{{.pfa_audit_action}}  user={{.user_id}}  entity={{.pfa_audit_entity_type}}:{{.pfa_audit_entity_id}}  workspace={{.pfa_workspace_id}}  ip={{.client_address}}  correlation={{.pfa_correlation_id}}\"",
