        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Failed logins",
      "description": "account.login_failed audit events (exact count from the logs).",
