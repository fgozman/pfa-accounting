{
  "uid": "pfa-audit",
  "title": "PFA — audit, security and traffic",
  "tags": [
    "pfa",
    "audit",
    "security",
    "opentelemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "pfa-loki"
        },
        "query": {
          "label": "service_name",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "",
          "type": 1
        },
        "definition": "label_values(service_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "pfa-loki"
        },
        "query": {
          "label": "env",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "",
          "type": 1
        },
        "definition": "label_values(env)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "correlation_id",
        "label": "Correlation id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview (selected time range)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Requests",
      "description": "HTTP requests handled (health probes and CORS preflights excluded).",
      "datasource": {
        "type": "loki",
        "uid": "pfa-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "pfa-loki"
          },
          "expr": "sum(count_over_time({service_name=~\"$service\", env=~\"$env\", event=\"http.request\"} [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "short",
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Server errors (5xx)",
      "description": "Requests answered with a 5xx status.",
      "datasource": {
        "type": "loki",
        "uid": "pfa-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "pfa-loki"
          },
          "expr": "sum(count_over_time({service_name=~\"$service\", env=~\"$env\", event=\"http.request\", level=\"error\"} [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "short",
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Refused (401/403/429)",
