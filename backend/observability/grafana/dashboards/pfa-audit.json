            "type": "loki",
            "uid": "pfa-loki"
          },
          "expr": "sum(count_over_time({service_name=~\"$service\", env=~\"$env\", event=~\"oauth.(code|refresh_token)_reuse_detected\"} [$__range]))",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
