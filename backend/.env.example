# ---------------------------------------------------------------------------
# Copy to .env (git-ignored) for local development:  cp .env.example .env
# NEVER commit real credentials. Production secrets come from a secret manager.
# ---------------------------------------------------------------------------

# Environment name. Must be one of: development | test | staging | production
PFA_ENV=development

# --- PostgreSQL (development) ----------------------------------------------
# Exposed on 127.0.0.1 only. Two roles:
#   * owner role   -> migrations / DDL (never used by the API at runtime)
#   * runtime role -> cannot bypass RLS, no superuser rights
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pfa
POSTGRES_OAUTH_DB=pfa_oauth
POSTGRES_OWNER_USER=pfa_owner
POSTGRES_OWNER_PASSWORD=dev_owner_password
POSTGRES_APP_USER=pfa_app
POSTGRES_APP_PASSWORD=dev_app_password

# --- Test PostgreSQL (isolated compose project) ----------------------------
TEST_POSTGRES_PORT=5433
TEST_POSTGRES_DB=pfa_test
TEST_POSTGRES_OAUTH_DB=pfa_oauth_test
TEST_POSTGRES_OWNER_USER=pfa_test_owner
TEST_POSTGRES_OWNER_PASSWORD=test_owner_password
TEST_POSTGRES_APP_USER=pfa_test_app
TEST_POSTGRES_APP_PASSWORD=test_app_password

# --- Application -----------------------------------------------------------
PFA_DATABASE_URL=postgresql+asyncpg://pfa_app:dev_app_password@127.0.0.1:5432/pfa
PFA_MIGRATION_DATABASE_URL=postgresql+asyncpg://pfa_owner:dev_owner_password@127.0.0.1:5432/pfa
# The OAuth 2.0 authorization server's OWN database (oauth_* tables only); same
# server in development, created by `make migrate` (or the init script on a new
# volume). Nothing spans the two databases.
PFA_OAUTH_DATABASE_URL=postgresql+asyncpg://pfa_app:dev_app_password@127.0.0.1:5432/pfa_oauth
PFA_OAUTH_MIGRATION_DATABASE_URL=postgresql+asyncpg://pfa_owner:dev_owner_password@127.0.0.1:5432/pfa_oauth

# Public base URL of the Python authorization service (authorization origin).
PFA_AUTHORIZATION_ORIGIN=http://127.0.0.1:8000
# Origin the SPA sends API requests to. The SPA never calls its own origin and
# there is no dev proxy: the browser does a real CORS preflight. Defaults to the
# authorization origin when empty.
PFA_API_ORIGIN=http://127.0.0.1:8000
# The SPA is a separate project. These values describe it to this service (CORS
# allowlist, e-mail links, registered OAuth client); the SPA's own build-time
# configuration lives in frontend/.env.example and must use the same values.
# Public base URL of the SPA (used for CORS allowlist and email links).
PFA_SPA_ORIGIN=http://127.0.0.1:5173
# Registered SPA OAuth callback. Must match oauth_redirect_uris exactly.
PFA_SPA_CALLBACK_URI=http://127.0.0.1:5173/auth/callback
PFA_SPA_CLIENT_ID=pfa-web-dev

# Interactive API documentation (Swagger UI at /docs, ReDoc at /redoc) and the
# OAuth client it uses.  Never mounted when PFA_ENV=production; the OpenAPI
# document at /openapi.json stays published in every environment.
PFA_DOCS_ENABLED=true

# --- Logging ---------------------------------------------------------------
# json: one JSON object per line on stdout (Loki/Elastic/Datadog...); text: readable.
# Empty = json in staging/production, text in development/test.
PFA_LOG_FORMAT=
PFA_LOG_LEVEL=INFO
# Client address in logs (GDPR minimisation): full | anonymized | off
PFA_LOG_CLIENT_IP=full

# --- OpenTelemetry (standard variables) -------------------------------------
# Traces and metrics are exported over OTLP/HTTP only when an endpoint is set;
# trace ids are written on log lines either way. `make dev-json-logs` sets it to
# the local Alloy (http://127.0.0.1:4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25
# OTEL_METRIC_EXPORT_INTERVAL=60000

# --- Optional: run the OAuth 2.0 authorization server as its own service -----
# Leave empty (default) to host it inside the application.  To split:
#   application:          PFA_AUTHORIZATION_SERVER_URL=<internal URL of the server>
#   authorization server: PFA_IDENTITY_PROVIDER_URL=<internal URL of the application>
#                         (start it with `make auth-server`)
#   both:                 the same PFA_INTERNAL_SERVICE_TOKEN (>= 32 random chars)
# and point PFA_AUTHORIZATION_ORIGIN (and the SPA) at the server's public origin.
PFA_AUTHORIZATION_SERVER_URL=
PFA_IDENTITY_PROVIDER_URL=
PFA_INTERNAL_SERVICE_TOKEN=

# Signing keys live OUTSIDE PostgreSQL (managed key service in production).
# Development: a local directory with PEM files (git-ignored).
PFA_KEY_DIR=./keys
PFA_KEY_ACTIVE_KID=dev-2026-01

# Token lifetimes (product policy, not protocol constants)
PFA_ACCESS_TOKEN_TTL_SECONDS=300
PFA_REFRESH_TOKEN_TTL_SECONDS=604800
PFA_AUTHORIZATION_TRANSACTION_TTL_SECONDS=300
PFA_AUTHORIZATION_CODE_TTL_SECONDS=60
PFA_INVITATION_TTL_SECONDS=604800

# Argon2id parameters (benchmark at deployment)
PFA_ARGON2_TIME_COST=3
PFA_ARGON2_MEMORY_COST=65536
PFA_ARGON2_PARALLELISM=4

# --- Object storage --------------------------------------------------------
PFA_OBJECT_STORAGE_DIR=./.run/objects

# File-capture e-mail sink used in development/test: the worker writes one JSON
# file per message and the API exposes it at GET /api/v1/dev/mailbox. It is a
# setting of its own so environments never share an inbox (the test suite clears
# only its own captured mail). Never used in production.
PFA_EMAIL_DIR=./.run/emails

# --- ANAF ------------------------------------------------------------------
# 'fake' is used for tests and local development. 'https' requires verified
# connector registration and capabilities recorded in afn_connector_capabilities.
PFA_ANAF_DRIVER=fake
PFA_ANAF_CLIENT_ID=
PFA_ANAF_CLIENT_SECRET=
PFA_ANAF_REDIRECT_URI=http://127.0.0.1:8000/integrations/anaf/callback
PFA_ANAF_ENVIRONMENT=test

# --- Seed (development only, refused when PFA_ENV=production) ---------------
PFA_SEED_ADMIN_EMAIL=admin@example.test
PFA_SEED_ADMIN_PASSWORD=Correct-Horse-Battery-9
PFA_SEED_MEMBER_EMAIL=member@example.test
PFA_SEED_MEMBER_PASSWORD=Correct-Horse-Battery-9
